# --- Jira site ---------------------------------------------------------------
# Jira Cloud or Data Center / Server base URL (a context path such as /jira is kept).
JIRA_URL=https://jira.company.com
# Use "cloud" for Jira Cloud API v3 and account email/API-token auth; default is "data_center".
JIRA_DEPLOYMENT=data_center
# stdio mode only (one user). Jira Cloud: set the account email and its API token.
JIRA_USERNAME=
JIRA_API_TOKEN=
# Set true only for an API token created with scopes; false (default) is for standard API tokens.
JIRA_API_TOKEN_SCOPED=false
# Data Center / Server stdio mode only. Create the PAT in Jira: your profile > Personal Access Tokens.
JIRA_PERSONAL_TOKEN=
# HTTPS origins a token may ever be sent to (comma-separated). Empty = only the origin of JIRA_URL.
# Include :port for non-standard HTTPS ports, e.g. jira.company.com:8443.
JIRA_ALLOWED_HOSTS=
# CIDRs permitted when Jira DNS resolves to a private/non-global IP, e.g. 10.20.0.0/16,fd00:1234::/48.
JIRA_ALLOWED_NETWORKS=
# HTTPS proxies resolve the Jira destination themselves. Enable only for a trusted proxy with egress restrictions.
JIRA_TRUST_HTTPS_PROXY=false
# Custom fields (display names) that create/update may set, besides the safe standard fields.
# Example: Team,Severity
JIRA_UPDATABLE_CUSTOM_FIELDS=

# --- Confluence site (optional, independent from Jira) -----------------------
# Include the Cloud /wiki context path when applicable, e.g. https://company.atlassian.net/wiki.
CONFLUENCE_URL=
# "cloud" uses account email/API-token auth; "data_center" uses a Confluence Personal Access Token.
CONFLUENCE_DEPLOYMENT=data_center
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
# Set true only for a Confluence API token created with scopes.
CONFLUENCE_API_TOKEN_SCOPED=false
CONFLUENCE_PERSONAL_TOKEN=
# HTTPS origins a Confluence token may be sent to. Empty = only the origin of CONFLUENCE_URL.
CONFLUENCE_ALLOWED_HOSTS=
# CIDRs permitted when Confluence DNS resolves to a private/non-global IP.
CONFLUENCE_ALLOWED_NETWORKS=
# HTTPS proxies resolve the Confluence destination themselves; trust only a restricted proxy.
CONFLUENCE_TRUST_HTTPS_PROXY=false

# --- Policy ------------------------------------------------------------------
# Tool groups that exist at all. "delete" is off unless you add it here.
# search, read, attachments, comments, write, transitions, agile, users, fields, links,
# confluence_read, confluence_write, confluence_attachments, delete
MCP_TOOL_GROUPS=search,read,attachments,comments,write,transitions,agile,users,fields,links,confluence_read,confluence_write,confluence_attachments
# true = no changes at all, whatever the groups say. Read-only is the default.
MCP_READ_ONLY=true
# elicit = the server asks the user to approve every change (client must support MCP elicitation).
# client = the calling app has its own approval step and is trusted to have asked the user.
MCP_CONFIRMATION_MODE=elicit

# --- Limits ------------------------------------------------------------------
MCP_MAX_RESULTS=200
MCP_MAX_ATTACHMENT_BYTES=1000000
MCP_REQUEST_TIMEOUT_SECONDS=30
MCP_RATE_LIMIT_PER_MINUTE=120
# HTTP Host values accepted by the HTTP listener, e.g. mcp.company.com:9200.
# Non-loopback listeners require this to be set.
MCP_HTTP_ALLOWED_HOSTS=
# Optional browser Origin values accepted by the HTTP listener, comma-separated.
MCP_HTTP_ALLOWED_ORIGINS=

# --- Audit -------------------------------------------------------------------
# One JSON line per change attempt (no tokens, no changed text). Empty disables it.
MCP_AUDIT_LOG=audit.jsonl

# --- Network -----------------------------------------------------------------
# Verify HTTPS with the operating system's certificate store (needed behind Zscaler and similar).
USE_SYSTEM_CERTIFICATES=true
# A corporate proxy, if Python cannot reach Jira/Confluence directly (e.g. Zscaler: http://127.0.0.1:9000).
HTTPS_PROXY=
